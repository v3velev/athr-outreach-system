# ==========================================================================
# athr daily outreach automation - SECRETS
# ==========================================================================
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env
#
# IMPORTANT: the system runs end-to-end WITHOUT any of these keys (mock mode),
# so you can test the whole pipeline first. Fill a key in to switch that one
# stage from "mock" to "live". Nothing else changes.
#
# NEVER commit the real .env to git (it is already in .gitignore).
# ==========================================================================

# --- Enrichment: find the decision-maker + verified email at each company ---
# Provider: Prospeo (https://prospeo.io). Header auth: X-KEY.
# Leave blank to use the built-in MOCK enricher (fake but realistic contacts).
PROSPEO_API_KEY=

# --- Message writing: the AI that writes each Bulgarian email ---
# Provider: Anthropic Claude (https://console.anthropic.com).
# Leave blank to use the built-in MOCK writer (rule-based Bulgarian template).
ANTHROPIC_API_KEY=

# --- Website finder: find a company's site from its name (the #1 yield lever) ---
# Provider: Parallel Search API (https://parallel.ai), ~$0.0064/company.
# Leave blank to run cache-only (reads data/company_websites.json; logs misses
# to data/website_lookups_needed.csv for an operator to fill).
PARALLEL_API_KEY=

# --- Email verification: confirm found emails are deliverable before sending ---
# Provider: Trykitt real-time SMTP verify (https://trykitt.ai), ~$0.0015/email.
# Leave blank to fall back to a weaker free MX/DNS check.
# (Prospeo emails are already BounceBan-verified and skip this step.)
TRYKITT_API_KEY=

# --- Sending: push the finished lead+message into a SmartLead campaign ---
# Provider: SmartLead (https://smartlead.ai). Query-param auth: ?api_key=
# Leave blank to use the built-in MOCK sender (writes a CSV you can inspect).
SMARTLEAD_API_KEY=
# The campaign ID the daily leads get added to. Create the campaign once in
# SmartLead (or with scripts/create_campaign.py) and paste its numeric ID here.
SMARTLEAD_CAMPAIGN_ID=
# Only needed for agency/sub-client accounts using the main key + client_id.
# Leave blank for a normal (or custom-API-key) account.
SMARTLEAD_CLIENT_ID=
