<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd job for the athr daily outreach run.
  Placeholders __PROJECT_DIR__ and __HOUR__ are filled in by scripts/setup_cron.sh.
  Runs once per day at __HOUR__:00 local time. If the Mac is asleep at that time,
  launchd runs the job as soon as it wakes (so a missed day self-heals).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.athr.outreach</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/run_once.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__HOUR__</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
